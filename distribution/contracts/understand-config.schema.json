{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dw.superapps/schemas/ua-runtime-config.schema.json",
  "title": "Understand Anything Runtime Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "dw.superapps/v1"
    },
    "kind": {
      "const": "PowerRuntimeConfig"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "powerId"
      ],
      "properties": {
        "powerId": {
          "const": "ua"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputLanguage",
        "autoUpdate",
        "reviewMode",
        "worktreeRedirect",
        "additionalExcludePatterns"
      ],
      "properties": {
        "outputLanguage": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "autoUpdate": {
          "type": "boolean"
        },
        "reviewMode": {
          "enum": [
            "deterministic",
            "llm"
          ]
        },
        "worktreeRedirect": {
          "type": "boolean"
        },
        "additionalExcludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
